{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["every friday", "before 3pm"]
  },
  "pre-commit": {
    "enabled": true,
    "schedule": ["every friday", "before 3pm"],
    "packageRules": [
      {
        "groupName": "pre-commit hooks",
        "matchManagers": ["pre-commit"],
        "matchDepTypes": ["repository"],
        "groupSlug": "precommit",
        "labels": ["pre-commit", "dependencies"]
      }
    ]
  },
  "labels": ["renovate"]
}
